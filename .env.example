# Copy to .env locally and replace placeholders; never commit .env.
GS_CLIENT_ID=<client-id>
GS_CLIENT_SECRET=<client-secret>
GS_OPEN_ACCESS_KEY=<access-key>
# Production: https://openapi.gs-robot.com/
# Test:       https://openapi.dev.gs-robot.com/
GS_BASE_URL=https://openapi.gs-robot.com/
GS_HTTP_TIMEOUT=30
GS_SERVER_API_KEY=<choose-a-strong-local-key>
GS_SERVER_HOST=0.0.0.0
GS_SERVER_PORT=8000
# Saodi (扫地僧) agent. The deprecated PI_AGENT_* names are still read for one release.
SAODI_PROVIDER=anthropic
SAODI_MODEL=claude-opus-5
ANTHROPIC_API_KEY=<anthropic-key>
# Set these when SAODI_PROVIDER=openai, and set SAODI_MODEL accordingly.
OPENAI_API_KEY=<openai-compatible-key>
OPENAI_BASE_URL=<openai-compatible-base-url>
SAODI_AUTO_APPROVE=0
SAODI_MAX_TURNS=12
# Optional: directory of private *.md notes appended to the system prompt.
# SAODI_CONTEXT_DIR=
# SAODI_CONTEXT_MAX_CHARS=60000
# Optional: local data dir for sessions / tool-call log / error threads (saodi.sqlite).
# SAODI_DATA_DIR=~/.saodi
